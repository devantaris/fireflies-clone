# ── Frontend ──────────────────────────────────────────────────────────────────
# URL the browser uses to reach the backend API.
# Must be reachable from the end user's browser — not the Docker network.
# Change only if you expose the backend on a different host or port.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ── Backend ───────────────────────────────────────────────────────────────────
# SQLite database file path (SQLAlchemy URL format).
# The default (relative path) works for local dev.
# In Docker Compose the path points to the named volume mounted at /app/data.
DATABASE_URL=sqlite:///./fireflies.db

# Comma-separated list of frontend origins allowed by CORS.
# Defaults to http://localhost:3000,http://127.0.0.1:3000 when not set.
CORS_ORIGINS=http://localhost:3000
